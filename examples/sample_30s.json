{
  "project": {
    "title": "vedit sample (30s)",
    "aspect": "16:9",
    "resolution": 1080,
    "fps": 30,
    "target_duration": 30,
    "font": "IPAGothic",
    "output": "../out/sample_30s.mp4",
    "bgm": {
      "file": "assets/bgm.wav",
      "fade_in": 0.5,
      "fade_out": 2.0
    },
    "overrides": {
      "9:16": {
        "styles": {
          "hook": {
            "size": 112
          },
          "emphasis": {
            "size": 80
          },
          "title": {
            "size": 88
          }
        },
        "cuts": {
          "talk": {
            "fit": "blur"
          },
          "broll": {
            "fit": "blur",
            "pip": {
              "source": "assets/wipe.mp4",
              "position": "tr",
              "scale": 0.5,
              "start": 0.3
            }
          }
        }
      }
    },
    "se_library": {
      "pop": "assets/se_pop.wav"
    }
  },
  "cuts": [
    {
      "id": "hook",
      "type": "hook",
      "duration": 4.0,
      "telop": "90秒で\n**未来**が変わる",
      "narration": {
        "file": "assets/nar_hook.wav",
        "offset": 0.4
      },
      "se": [
        {
          "file": "assets/se_impact.wav",
          "at": 0.0,
          "volume": 0.9
        }
      ]
    },
    {
      "id": "talk",
      "source": "assets/talk.mp4",
      "jumpcut": {
        "keep_pauses": [
          {
            "type": "scene_change",
            "at": 7.0
          },
          {
            "type": "before_punchline",
            "at": 10.7
          },
          {
            "type": "after_punchline",
            "at": 12.6
          }
        ]
      },
      "telop": [
        {
          "text": "ジャンプカット：無音を自動カット",
          "style": "label"
        },
        {
          "text": "無音を**自動で**カット",
          "preset": "A",
          "end": 4.1
        },
        {
          "text": "間はちゃんと残す",
          "preset": "B",
          "start": 4.1,
          "end": 6.6
        },
        {
          "text": "オチ前の間もキープ",
          "preset": "C",
          "start": 6.6
        }
      ],
      "effects": [],
      "se": [
        {
          "file": "assets/se_pop.wav",
          "at": 4.1
        }
      ]
    },
    {
      "id": "photo",
      "source": "assets/photo1.png",
      "duration": 4.2,
      "effects": [
        {
          "type": "kenburns",
          "from": {
            "zoom": 1.0,
            "x": 0.5,
            "y": 0.5
          },
          "to": {
            "zoom": 1.6,
            "x": 0.62,
            "y": 0.42
          }
        }
      ],
      "narration": "assets/nar_photo.wav",
      "telop": {
        "text": "静止画も**ズーム**で動かす",
        "preset": "A"
      },
      "se": [
        {
          "file": "assets/se_whoosh.wav",
          "at": 0.0,
          "volume": 0.8
        }
      ]
    },
    {
      "id": "broll",
      "source": "assets/broll.mp4",
      "source_volume": 0,
      "duration": "narration",
      "narration": "assets/nar_broll.wav",
      "jumpcut": {
        "target": "narration",
        "min_silence": 0.5
      },
      "pip": {
        "source": "assets/wipe.mp4",
        "position": "tr",
        "scale": 0.3,
        "start": 0.3,
        "border": 6
      },
      "effects": [
        {
          "type": "zoom_in",
          "to": 1.08,
          "ease": "linear"
        }
      ],
      "telop": [
        {
          "text": "ワイプで**2画面**同時に",
          "preset": "A",
          "end": 2.6
        },
        {
          "text": "BGMは声に合わせて\n{c=#66D9FF}自動で小さく{/}",
          "preset": "A",
          "start": 2.6
        }
      ]
    },
    {
      "id": "pan",
      "source": "assets/photo2.png",
      "duration": 4.5,
      "effects": [
        {
          "type": "pan",
          "direction": "right",
          "zoom": 1.35
        }
      ],
      "narration": "assets/nar_pan.wav",
      "telop": [
        {
          "text": "カット表から**全部自動**で生成",
          "preset": "A",
          "end": 3.2
        },
        {
          "text": "編集ソフトいらず",
          "preset": "C_light",
          "start": 3.2
        }
      ],
      "se": []
    },
    {
      "id": "outro",
      "type": "title",
      "duration": 4.2,
      "telop": [
        {
          "text": "Google AI Challenge\n**応募作品**",
          "style": "title",
          "anim": "pop"
        },
        {
          "text": "Made with ffmpeg + vedit",
          "style": "label",
          "start": 0.6,
          "anim": "fade"
        }
      ],
      "effects": [
        {
          "type": "zoom_out",
          "from": 1.15,
          "to": 1.0,
          "ease": "out"
        },
        {
          "type": "fade_out",
          "duration": 0.6
        }
      ],
      "se": [
        {
          "file": "assets/se_pop.wav",
          "at": 0.05
        }
      ]
    }
  ]
}

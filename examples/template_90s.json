{
  "project": {
    "title": "Google AI Challenge 応募動画 (90秒テンプレート)",
    "aspect": "16:9",
    "resolution": 1080,
    "fps": 30,
    "target_duration": 90,
    "output": "../out/challenge_90s.mp4",
    "bgm": { "file": "assets/bgm.wav", "volume": 0.35 },
    "styles": {
      "subtitle": { "size": 72, "outer_outline_color": "#1E64FF", "outer_outline": 6,
                    "highlight": { "color": "#FFE600", "scale": 1.25 } }
    },
    "overrides": {
      "9:16": {
        "styles": {
          "default":  { "size": 60, "margin_v": 330, "margin_h": 60 },
          "subtitle": { "size": 60, "margin_v": 330 },
          "hook": { "size": 108 }, "title": { "size": 84 }
        }
      }
    }
  },
  "cuts": [
    { "id": "01_hook", "type": "hook", "duration": 4.0,
      "telop": "その作業、\n**AIで90%減**らせます",
      "se": [ { "file": "assets/se_impact.wav", "at": 0 } ] },

    { "id": "02_problem_title", "type": "title", "duration": 2.5, "telop": "**課題**" },
    { "id": "03_problem", "source": "assets/talk.mp4", "jumpcut": true,
      "telop": [ { "text": "現場では|毎日|**3時間**|が|手作業に", "style": "subtitle", "anim": "words" },
                 { "text": "課題", "style": "label" } ] },
    { "id": "04_problem_data", "source": "assets/photo2.png", "duration": 9.9,
      "effects": [ { "type": "pan", "direction": "right", "zoom": 1.3 } ],
      "telop": { "text": "{c=#FF5A5A,s=1.3}年間 700時間{/} の損失", "style": "subtitle", "anim": "pop" } },

    { "id": "05_solution_title", "type": "title", "duration": 2.5, "telop": "**解決策**",
      "se": [ { "file": "assets/se_whoosh.wav", "at": 0 } ] },
    { "id": "06_solution", "source": "assets/photo1.png", "duration": 10.0,
      "effects": [ { "type": "kenburns", "to": { "zoom": 1.5, "x": 0.6, "y": 0.45 } } ],
      "narration": "assets/nar_photo.wav",
      "telop": [ { "text": "Gemini で|**自動判定**|する|仕組み", "style": "subtitle", "anim": "karaoke", "end": 5 },
                 { "text": "人は|**確認するだけ**", "style": "subtitle", "anim": "words", "start": 5 } ] },

    { "id": "07_demo_title", "type": "title", "duration": 2.5, "telop": "**デモ**" },
    { "id": "08_demo", "source": "assets/broll.mp4", "in": 0, "out": 12, "source_volume": 0,
      "pip": { "source": "assets/wipe.mp4", "position": "br", "scale": 0.28, "start": 0.5 },
      "narration": "assets/nar_broll.wav",
      "effects": [ { "type": "zoom_in", "to": 1.1, "ease": "linear" } ],
      "telop": [ { "text": "画面を|撮るだけで", "style": "subtitle", "anim": "words", "end": 4 },
                 { "text": "**3秒**で結果が出る", "style": "subtitle", "anim": "pop", "start": 4, "end": 8 },
                 { "text": "そのまま|共有も|OK", "style": "subtitle", "anim": "words", "start": 8 } ] },
    { "id": "09_demo2", "source": "assets/talk.mp4", "in": 2, "out": 13, "jumpcut": true,
      "effects": [ { "type": "punch_in", "start": 2.0, "to": 1.2 },
                   { "type": "shake", "start": 2.0, "duration": 0.3 } ],
      "telop": { "text": "ここが**ポイント**", "style": "emphasis", "anim": "pop", "start": 2.0 } },

    { "id": "10_impact_title", "type": "title", "duration": 2.5, "telop": "**効果**" },
    { "id": "11_impact", "source": "assets/photo2.png", "duration": 10.0,
      "effects": [ { "type": "zoom_in", "to": 1.25 } ],
      "telop": [ { "text": "作業時間 **-90%**", "style": "hook", "anim": "pop", "end": 5 },
                 { "text": "ミス |**ゼロ**| を目指せる", "style": "subtitle", "anim": "words", "start": 5 } ],
      "se": [ { "file": "assets/se_pop.wav", "at": 0.1 }, { "file": "assets/se_pop.wav", "at": 5.0 } ] },
    { "id": "12_future", "source": "assets/photo1.png", "duration": 14.0,
      "effects": [ { "type": "zoom_out", "from": 1.4, "to": 1.0 } ],
      "narration": "assets/nar_pan.wav",
      "telop": { "text": "他の現場にも|**横展開**|できる", "style": "subtitle", "anim": "karaoke" } },

    { "id": "13_cta", "type": "title", "duration": 8.0,
      "telop": [ { "text": "チーム名\n**プロダクト名**", "style": "title", "anim": "pop" },
                 { "text": "Google AI Challenge 2026", "style": "label", "start": 0.8, "anim": "fade" } ],
      "effects": [ { "type": "fade_out", "duration": 1.0 } ] }
  ]
}
